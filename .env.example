# Public app configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase admin key (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# Required in production to sign tamper-resistant outbound affiliate links
RIGHTPRICE_CLICKOUT_SECRET=change-me-to-a-long-random-secret

# eBay Browse API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CAMPAIGN_ID=
ENABLE_EBAY_CONNECTOR=false

# Core feature flags
ENABLE_DEMO_CONNECTOR=true
ENABLE_CASHBACK=false
ENABLE_REFERRALS=true
ENABLE_LEVEL_TWO_REFERRALS=false
ENABLE_PRICE_HISTORY=true

# Optional generic approved JSON product/affiliate feed
ENABLE_GENERIC_FEED=false
GENERIC_FEED_URL=
GENERIC_FEED_NAME=Approved Merchant Feed
GENERIC_FEED_ALLOWS_CASHBACK=false
GENERIC_FEED_QUERY_PARAM=
GENERIC_FEED_AUTH_HEADER=
GENERIC_FEED_AUTH_TOKEN=

# Approved affiliate-network / retailer feeds.
# Each enabled feed must normalize rows to the documented RightPrice feed schema.
# *_QUERY_PARAM optionally tells RightPrice to forward the shopper query to the endpoint.
# *_AUTH_HEADER + *_AUTH_TOKEN optionally add one server-only authentication header.
# Cashback remains disabled unless that program explicitly permits it.
IMPACT_ENABLED=false
IMPACT_FEED_URL=
IMPACT_QUERY_PARAM=
IMPACT_AUTH_HEADER=
IMPACT_AUTH_TOKEN=
IMPACT_ALLOWS_CASHBACK=false

CJ_ENABLED=false
CJ_FEED_URL=
CJ_QUERY_PARAM=
CJ_AUTH_HEADER=
CJ_AUTH_TOKEN=
CJ_ALLOWS_CASHBACK=false

