# Public app configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase admin key (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# Required in production to sign tamper-resistant outbound affiliate links
RIGHTPRICE_CLICKOUT_SECRET=change-me-to-a-long-random-secret

# eBay Browse API (optional; mock connector works without these)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CAMPAIGN_ID=

# Feature flags
ENABLE_DEMO_CONNECTOR=true
ENABLE_EBAY_CONNECTOR=false
ENABLE_CASHBACK=false
ENABLE_REFERRALS=true
ENABLE_LEVEL_TWO_REFERRALS=false
ENABLE_PRICE_HISTORY=true

# Optional approved JSON affiliate/product feed
ENABLE_GENERIC_FEED=false
GENERIC_FEED_URL=
GENERIC_FEED_NAME=Approved Merchant Feed
GENERIC_FEED_ALLOWS_CASHBACK=false

# Protects /api/cron/* scheduled endpoints. Generate a long random value.
CRON_SECRET=

# Protects normalized affiliate transaction ingestion from approved network adapters.
AFFILIATE_INGEST_SECRET=
